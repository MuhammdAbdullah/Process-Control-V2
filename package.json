{
  "name": "process-control-v2",
  "version": "0.1.10",
  "description": "Process Control V2 - Web App for Android Tablets",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/ensure-utf8.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "web": "node server.js",
    "web-dev": "nodemon server.js",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-all": "electron-builder --win --mac --linux",
    "rebuild-hid": "electron-rebuild -f -w node-hid"
  },
  "keywords": [
    "electron",
    "com-port",
    "process-control-v2",
    "serial",
    "web-app",
    "android",
    "pwa"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.10"
  },
  "dependencies": {
    "chart.js": "^4.4.4",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "node-hid": "^3.1.1",
    "qrcode": "^1.5.4",
    "serialport": "^12.0.0"
  },
  "build": {
    "appId": "com.processcontrol.v2",
    "productName": "Process Control V2",
    "publish": {
      "provider": "github",
      "owner": "MuhammdAbdullah",
      "repo": "Process-Control-V2"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "renderer-hardware.js",
      "layout.js",
      "landing.html",
      "index.html",
      "pressure.html",
      "level.html",
      "flow.html",
      "servo-speed.html",
      "servo-angle.html",
      "server.js",
      "manifest.json",
      "package.json",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "Process-Control-V2-Setup-${version}.${ext}"
    }
  }
}
